# ============================================================
# IBSB App — Variáveis de ambiente (NUNCA commit os valores reais)
# Copie este arquivo para `.env` e preencha com valores reais.
# ============================================================

# --- Fonte de dados -------------------------------------------
# demo | supabase
VITE_DATA_MODE=demo

# --- Supabase (integracao real de producao) --------------------
# Para ativar, rode /docs/supabase.sql no SQL Editor do seu
# projeto Supabase, crie o admin em Auth, e troque VITE_DATA_MODE.
# A "anon key" e publica por design; a seguranca e feita por RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Autenticacao do painel administrativo (modo demo) --------
# Usuario e senha usados apenas enquanto VITE_DATA_MODE=demo.
# Em producao, a autenticacao usa o Supabase Auth (usuario criado
# no painel do Supabase); estas variaveis sao ignoradas.
VITE_ADMIN_EMAIL=admin@ibsb.com.br
VITE_ADMIN_PASSWORD=ibsb-admin

# --- Identidade visual ----------------------------------------
VITE_CHURCH_NAME=IBSB
VITE_CHURCH_FULL_NAME=Igreja Batista do Sevilha B

# --- Transmissao ao vivo (integração futura com YouTube) ------
# Deixe VAZIO para exibir "Nao estamos ao vivo neste momento".
VITE_LIVE_URL=
VITE_LIVE_ACTIVE=false

# --- YouTube (integracao futura de pregações) -----------------
VITE_YOUTUBE_API_KEY=
VITE_YOUTUBE_CHANNEL_ID=
